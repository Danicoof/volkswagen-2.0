{
    "compilerOptions": {
        "lib": [
            "esnext"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "strict": true,
        "declaration": true,
        "noEmit": true,
        "isolatedModules": true
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}